#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/mediatek,mt8188-pinfunc.h>

/dts-v1/;
/plugin/;

/ {
	fragment@0 {
		target-path = "/";
		__overlay__ {
			csi0_mclk: csi0-mclk {
				#clock-cells = <0>;
				clock-frequency = <24000000>;
				compatible = "fixed-clock";
			};
		};
	};

	fragment@1 {
		target = <&pio>;
		__overlay__ {
			camera_pins_cam0_rst: cam0-rst {
				pins_cmd_dat {
					pinmux = <PINMUX_GPIO0__FUNC_B_GPIO0>;
					output-low;
				};
			};
		};
	};

	fragment@2 {
		target = <&i2c3>;
		__overlay__ {
			#address-cells = <1>;
			#size-cells = <0>;

			pivariety_0: camera@c {
				compatible = "arducam,arducam-pivariety";
				reg = <0x0c>;
				pinctrl-names = "default";
				pinctrl-0 = <&camera_pins_cam0_rst>;
				clocks = <&csi0_mclk>;
				clock-names = "xclk";
				reset-gpios = <&pio 0 GPIO_ACTIVE_HIGH>;
				orientation = <2>;
				rotation = <0>;

				port {
					sensor0_out: endpoint {
						remote-endpoint = <&seninf_csi_port_0_in>;
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <493500000>;
					};
				};
			};
		};
	};

	fragment@3 {
		target = <&seninf_csi_port_0>;
		__overlay__ {
			status = "okay";
			settle_delay_ck = <0x50>;
			hs_trail_parameter = <0x20>;
			port {
				seninf_csi_port_0_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&sensor0_out>;
				};
			};
		};
	};
};
