	dsi0_iovcc_pins_default: dsi0-iovcc-pins-default {
		panel-en {
			pinmux = <PINMUX_GPIO58__FUNC_GPIO58>;
			output-low;
		};
	};

	/* AUDIO GPIO standardization start */
	/* Audio I2S Interface */
	aud_gpio_i2sin0_off: aud-gpio-i2sin0-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO103__FUNC_GPIO103>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO104__FUNC_GPIO104>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO105__FUNC_GPIO105>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO106__FUNC_GPIO106>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_i2sin0_on: aud-gpio-i2sin0-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO103__FUNC_I2SIN0_MCK>;
			input-schmitt-enable;
			bias-disable;
		};

		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO104__FUNC_I2SIN0_BCK>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO105__FUNC_I2SIN0_LRCK>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO106__FUNC_I2SIN0_DI>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_i2sout0_off: aud-gpio-i2sout0-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO107__FUNC_GPIO107>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO108__FUNC_GPIO108>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO109__FUNC_GPIO109>;
			input-enable;
			bias-pull-down;
		};

		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO110__FUNC_GPIO110>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_i2sout0_on: aud-gpio-i2sout0-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO107__FUNC_I2SOUT0_MCK>;
			input-schmitt-enable;
			bias-disable;
		};

		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO108__FUNC_I2SOUT0_BCK>;
			input-schmitt-enable;
			bias-disable;
		};

		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO109__FUNC_I2SOUT0_LRCK>;
			input-schmitt-enable;
			bias-disable;
		};

		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO110__FUNC_I2SOUT0_DO>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	/* Audio DMIC Interface */
	aud_gpio_ap_dmic_off: aud-gpio-ap-dmic-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO111__FUNC_GPIO111>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO112__FUNC_GPIO112>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_ap_dmic_on: aud-gpio-ap-dmic-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO111__FUNC_DMIC0_CLK>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO112__FUNC_DMIC0_DAT0>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	/* Audio PCM Interface */
	aud_gpio_pcm_off: aud-gpio-pcm-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO115__FUNC_GPIO115>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO116__FUNC_GPIO116>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO117__FUNC_GPIO117>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO118__FUNC_GPIO118>;
			input-enable;
			bias-pull-down;
		};
	};

	aud_gpio_pcm_on: aud-gpio-pcm-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO115__FUNC_PCM0_CLK>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO116__FUNC_PCM0_SYNC>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO117__FUNC_PCM0_DI>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO118__FUNC_PCM0_DO>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	aud_gpio_pmic_off: aud-gpio-pmic-off {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO97__FUNC_GPIO97>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO98__FUNC_GPIO98>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO99__FUNC_GPIO99>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO100__FUNC_GPIO100>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd5-dat {
			pinmux = <PINMUX_GPIO101__FUNC_GPIO101>;
			input-enable;
			bias-pull-down;
		};
		pins-cmd6-dat {
			pinmux = <PINMUX_GPIO102__FUNC_GPIO102>;
			input-enable;
			bias-disable;
		};
	};

	aud_gpio_pmic_on: aud-gpio-pmic-on {
		pins-cmd1-dat {
			pinmux = <PINMUX_GPIO97__FUNC_AUD_CLK_MOSI>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd2-dat {
			pinmux = <PINMUX_GPIO98__FUNC_AUD_SYNC_MOSI>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd3-dat {
			pinmux = <PINMUX_GPIO99__FUNC_AUD_DAT_MOSI0>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd4-dat {
			pinmux = <PINMUX_GPIO100__FUNC_AUD_DAT_MOSI1>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd5-dat {
			pinmux = <PINMUX_GPIO101__FUNC_AUD_DAT_MISO0>;
			input-schmitt-enable;
			bias-disable;
		};
		pins-cmd6-dat {
			pinmux = <PINMUX_GPIO102__FUNC_AUD_DAT_MISO1>;
			input-schmitt-enable;
			bias-disable;
		};
	};

	/* AUDIO GPIO standardization end */
	spi0_pins: spi0-pins {
		pins-spi-bus {
			pinmux = <PINMUX_GPIO69__FUNC_SPIM0_CSB>,
				<PINMUX_GPIO70__FUNC_SPIM0_CLK>,
				<PINMUX_GPIO71__FUNC_SPIM0_MO>,
				<PINMUX_GPIO72__FUNC_SPIM0_MI>;
				drive-strength = <MTK_DRIVE_6mA>;
		};
		pin-can-rst {
			pinmux = <PINMUX_GPIO82__FUNC_GPIO82>;
			output-high;
		};

		pin-can-standby {
			pinmux = <PINMUX_GPIO45__FUNC_GPIO45>;
			output-low;
		};
	};
};

&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6359_vpa_buck_reg>;
	vqmmc-supply = <&mt6359_vsim1_ldo_reg>;
};

&mt6359_vpa_buck_reg {
	regulator-max-microvolt = <3000000>;
};

&mt6359_vsim1_ldo_reg {
	regulator-enable-ramp-delay = <480>;
};

&mmc2 {
	status = "okay";
	interrupts-extended = <&gic GIC_SPI 389 IRQ_TYPE_LEVEL_HIGH 0>,
			      <&pio 177 IRQ_TYPE_LEVEL_LOW>;
	interrupt-names = "sdio", "sdio_wakeup";
	pinctrl-names = "default", "state_uhs", "state_eint";
	pinctrl-0 = <&mmc2_pins_default>;
	pinctrl-1 = <&mmc2_pins_uhs>;
	pinctrl-2 = <&mmc2_pins_eint>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	wakeup-source;
	cap-sdio-irq;
	mediatek,disable-single-burst;
	no-mmc;
	no-sd;
	non-removable;
	vmmc-supply = <&sdio_fixed_3v3>;
	vqmmc-supply = <&sdio_fixed_1v8>;
};

&nor_flash {
	pinctrl-names = "default";
	pinctrl-0 = <&nor_pins_default>;

	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <2>;
		spi-tx-bus-width = <2>;
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "nor_bl2";
				reg = <0x0 0x200000>;
				read-only;
			};

			partition@200000 {
				label = "nor_fip_a";
				reg = <0x200000 0x200000>;
				read-only;
			};

			partition@400000 {
				label = "nor_fip_b";
				reg = <0x400000 0x200000>;
				read-only;
			};

			partition@600000 {
				label = "nor_firmware_a";
				reg = <0x600000 0x200000>;
				read-only;
			};

			partition@800000 {
				label = "nor_nor_firmware_b";
				reg = <0x800000 0x200000>;
				read-only;
			};

			partition@a00000 {
				label = "nor_dramk";
				reg = <0xa00000 0x80000>;
				read-only;
			};

			partition@a80000 {
				label = "nor_misc";
				reg = <0xa80000 0x100000>;
				read-only;
			};

			partition@b80000 {
				label = "nor_bootassets";
				reg = <0xb80000 0x200000>;
			};

			partition@d80000 {
				label = "nor_env";
				reg = <0xd80000 0x200000>;
			};
		};
	};
};

&uart0 {
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&uart1 {
	pinctrl-0 = <&uart1_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&uart3 {
	pinctrl-0 = <&uart3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

&ssusb {
	pinctrl-names = "default";
	pinctrl-0 = <&usb0_default_pins>;
	wakeup-source;
	vusb33-supply = <&mt6359_vusb_ldo_reg>;
};

&xhci1 {
	vusb33-supply = <&mt6359_vusb_ldo_reg>;
	vbus-supply = <&usb_p1_vbus>;
	wakeup-source;
	status = "okay";
};

&xhci2 {
	wakeup-source;
	status = "okay";
};

&xhci3 {
	vusb33-supply = <&mt6359_vusb_ldo_reg>;
	wakeup-source;
	status = "okay";
};

&xhci4 {
	wakeup-source;
	status = "okay";
};

&i2c0{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";
};

&i2c1{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pins>;
	status = "okay";
};

&i2c2{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;
	status = "okay";
};

&i2c3{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pins>;
	status = "disabled";
};

&i2c4{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pins>;
	status = "okay";

	mt6375@34 {
		compatible = "mediatek,mt6375";
		reg = <0x34>;
		pinctrl-names = "default";
		pinctrl-0 = <&mt6375_int_pins>;
		interrupts-extended = <&pio 9 IRQ_TYPE_LEVEL_LOW>;
		interrupt-controller;
		#interrupt-cells = <1>;
		wakeup-source;
		status = "okay";

		mt6375_tcpc: mt6375-tcpc {
			compatible = "mediatek,mt6375-tcpc";
			interrupts = <MT6375_PD_EVT>;

			usb_con_p0: connector {
				compatible = "usb-c-connector";
				label = "USB-C";
				data-role = "dual";
				power-role = "dual";
				try-power-role = "sink";
				source-pdos = <PDO_FIXED(5000, 500, PDO_FIXED_DUAL_ROLE |
							 PDO_FIXED_USB_COMM |
							 PDO_FIXED_DATA_SWAP)>;
				sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_DUAL_ROLE |
						       PDO_FIXED_USB_COMM |
						       PDO_FIXED_DATA_SWAP)>;
				op-sink-microwatt = <10000000>;
			};

			port {};
		};
	};
};

&i2c5{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";

	rt1715_p3: rt1715@4e {
		compatible = "richtek,rt1715";
		reg = <0x4e>;
		pinctrl-names = "default";
		pinctrl-0 = <&rt1715_int_pins>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		vbus-supply = <&usb_p3_vbus>;
		status = "okay";

		usb_con_p3: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_DUAL_ROLE |
							PDO_FIXED_DATA_SWAP)>;
			sink-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_DUAL_ROLE |
							PDO_FIXED_DATA_SWAP)>;
			op-sink-microwatt = <10000000>;
		};

		port {};
	};
};

&i2c6{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pins>;
	status = "okay";
	clock-frequency = <400000>;
	/* touch device  */
	touchscreen@14 {
		compatible = "goodix,gt9271";
		reg = <0x14>;
		interrupt-parent = <&pio>;
		interrupts-extended = <&pio 11 IRQ_TYPE_EDGE_RISING>;
		irq-gpios = <&pio 11  GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
		AVDD28-supply = <&touch0_fixed_3v3>;
		VDDIO-supply = <&mt6359_vio18_ldo_reg>;
		pinctrl-names = "default";
		pinctrl-0 = <&touch_pins>;
	};
};

&i2c7{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c7_pins>;
	status = "okay";
};

&i2c8{
	pinctrl-names = "default";
	pinctrl-0 = <&i2c8_pins>;
	status = "okay";
};

/* port0 usb typec mux start */
&usb_con_p0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			tcpc_ssusb_mux_ep_p0: endpoint {
				remote-endpoint = <&ssusb_mux_ep_p0>;
			};
		};

		port@1 {
			reg = <1>;
			tcpc_ssusb_ep_p0: endpoint {
				remote-endpoint = <&ssusb_ep_p0>;
			};
		};
	};
};

&usb_dp_selector {
	orientation-switch;
	mode-switch;
	status = "okay";

	port {
		ssusb_mux_ep_p0: endpoint {
			remote-endpoint = <&tcpc_ssusb_mux_ep_p0>;
		};
	};
};

&ssusb {
	port {
		ssusb_ep_p0: endpoint {
			remote-endpoint = <&tcpc_ssusb_ep_p0>;
		};
	};
};
/* port0 usb typec mux end */

/* port3 rt1715 typec mux start */
&usb_con_p3 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
		port@0 {
			reg = <0>;
			tcpc_ssusb_mux_ep_p3: endpoint {
				remote-endpoint = <&ssusb_mux_ep_p3>;
			};
		};
	};
};

&usb_dp_selector_p3 {
	orientation-switch;
	status = "okay";
	port {
		ssusb_mux_ep_p3: endpoint {
			remote-endpoint = <&tcpc_ssusb_mux_ep_p3>;
		};
	};
};
/* port3 rt1715 typec mux end */

&eth {
	phy-mode ="rgmii-rxid";
	phy-handle = <&phy>;
	snps,reset = <&pio 135 0>;
	snps,reset-delays-us = <0 10000 10000>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&eth_default_pins>;
	pinctrl-1 = <&eth_sleep_pins>;
	status = "okay";
	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
		phy: phy@0{
			compatible = "ethernet-phy-idc0ff.0421";
			reg = <0>;
		};
	};
};

&auxadc {
	status = "okay";
};

&pcie {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_default_pins>;
	status = "okay";
};

&pciephy {
	status = "okay";
};

&mt6359codec {
	mediatek,mic-type-0 = <1>;
	mediatek,mic-type-1 = <3>;
	mediatek,mic-type-2 = <1>;
};

&afe {
	memory-region = <&afe_dma_mem_reserved>;
	status = "okay";
};

&sound {
	compatible = "mediatek,mt8189-mt6359p-sound";
	model = "mt8391-evk";
	status = "okay";

	pinctrl-names = "aud-gpio-i2sin0-off",
		"aud-gpio-i2sin0-on",
		"aud-gpio-i2sout0-off",
		"aud-gpio-i2sout0-on",
		/*dmic*/
		"aud-gpio-ap-dmic-off",
		"aud-gpio-ap-dmic-on",
		/*pcm*/
		"aud-gpio-pcm-off",
		"aud-gpio-pcm-on",
		/* pmic */
		"aud-gpio-pmic-off",
		"aud-gpio-pmic-on";

	/* i2s */
	pinctrl-0 = <&aud_gpio_i2sin0_off>;
	pinctrl-1 = <&aud_gpio_i2sin0_on>;
	pinctrl-2 = <&aud_gpio_i2sout0_off>;
	pinctrl-3 = <&aud_gpio_i2sout0_on>;
	/* dmic */
	pinctrl-4 = <&aud_gpio_ap_dmic_off>;
	pinctrl-5 = <&aud_gpio_ap_dmic_on>;
	/* pcm */
	pinctrl-6 = <&aud_gpio_pcm_off>;
	pinctrl-7 = <&aud_gpio_pcm_on>;
	/* pmic */
	pinctrl-8 = <&aud_gpio_pmic_off>;
	pinctrl-9 = <&aud_gpio_pmic_on>;

	audio-routing = "I2SOUT0", "ETDMOUT_HP_PIN",
			"I2SIN0", "ETDMIN_HP_PIN",
			"AP DMIC Capture", "AP_DMIC0_PIN",
			"AP DMIC Capture", "MIC_BIAS_0",
			"PCM 0 Capture", "ETDMOUT_HDMI_PIN",
			"PCM 0 Playback", "ETDMOUT_HDMI_PIN",
			"ADDA Capture", "PMIC_CODEC_PIN",
			"ADDA Playback", "PMIC_CODEC_PIN";

	dai-link-0 {
		link-name = "AP_DMIC_BE";

		codec {
			sound-dai = <&dmic_codec>;
		};
	};

	dai-link-1 {
		link-name = "ADDA_BE";

		codec {
			sound-dai = <&pmic 0>, <&accdet>, <&amic_codec>;
		};
	};
};

&gpu {
	supply-names = "mali", "sram";
	mali-supply = <&mt6359_vproc1_buck_reg>;
	sram-supply = <&mt6359_vsram_proc1_ldo_reg>;
	status = "okay";
};

&sspm {
	memory-region = <&sspm_resv_mem>;
	scmi = <&scmi>;
	mboxes = <&tinysys_mbox 0>;
	status = "okay";
};

&spi0 {
	pinctrl-0 = <&spi0_pins>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	can0: can0@0 {
		compatible = "microchip,mcp2518fd";
		reg = <0>;
		clocks = <&can_clk>;
		spi-max-frequency = <10000000>;
		interrupts-extended = <&pio 76 IRQ_TYPE_LEVEL_LOW>;
		vdd-supply = <&can_5v>;
		xceiver-supply = <&can_5v>;
	};
};
