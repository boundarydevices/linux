	panel0_pins_default: panel0-pins-default {
		pins-cmd-dat {
			pinmux = <PINMUX_GPIO87__FUNC_GPIO87>,
				 <PINMUX_GPIO13__FUNC_GPIO13>,
				 <PINMUX_GPIO25__FUNC_GPIO25>;
			output-high;
		};
	};

	dsi0_pp3300_pins_default: dsi0-pp3300-pins-default {
