			mediatek,larbs = <&smi_larb0 &smi_larb1 &smi_larb2 &smi_larb4 &smi_larb7
					  &smi_larb9 &smi_larb11 &smi_larb13 &smi_larb14
					  &smi_larb16 &smi_larb17 &smi_larb19 &smi_larb20>;
			power-domains = <&scpsys MT8189_POWER_DOMAIN_MM_INFRA>;
		};

