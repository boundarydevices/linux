		u3phy0: xs-phy0@11e80000 {
			compatible = "mediatek,xsphy";
			reg = <0 0x11e83000 0 0x200>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			u2port0: usb2-phy0@11e80000 {
				reg = <0 0x11e80000 0 0x400>;
				clocks = <&topckgen_clk CLK_TOP_USB2_PHY_RF_P0_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};

			u3port0: usb3-phy0@11e83000 {
				reg = <0 0x11e83400 0 0x500>;
				clocks = <&topckgen_clk CLK_TOP_USB2_PHY_RF_P0_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
