		u2phy2: xs-phy2@11ef0000 {
			compatible = "mediatek,xsphy";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			u2port2: usb2-phy2@11ef0000 {
				reg = <0 0x11ef0000 0 0x400>;
