				polling-delay-passive = <0>; /* milliseconds */
				thermal-sensors = <&lvts 3>;
				trips {
					cpu_big3_crit: cpu-big3-crit {
						temperature = <119000>;
						hysteresis = <2000>;
						type = "critical";
					};
				};
			};
			cpu-big4 {
				polling-delay = <0>; /* milliseconds */
				polling-delay-passive = <0>; /* milliseconds */
