		u2phy1: xs-phy1@11e90000 {
			compatible = "mediatek,xsphy";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

			u2port1: usb2-phy1@11e90000 {
				reg = <0 0x11e90000 0 0x700>;
				clocks = <&topckgen_clk CLK_TOP_USB2_PHY_RF_P1_EN>;
