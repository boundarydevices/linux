			u2port3: usb2-phy3@11b00000 {
				reg = <0 0x11b00000 0 0x400>;
				clocks = <&topckgen_clk CLK_TOP_USB2_PHY_RF_P3_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};

			u3port3: usb3-phy3@11b00700 {
				reg = <0 0x11b00700 0 0x700>;
				clocks = <&topckgen_clk CLK_TOP_USB2_PHY_RF_P3_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
				mediatek,keep-u3-phy-power;
			};
		};

		u2phy4: xs-phy4@11b10000 {
